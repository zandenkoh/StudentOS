# StudentOS sponsor mode
NEXT_PUBLIC_USE_REAL_SPONSOR_TECH=true

# Vercel AI Gateway
USE_REAL_VERCEL_AI=true
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=
AI_GATEWAY_MODEL=openai/gpt-5.4
AI_GATEWAY_FALLBACK_MODEL=anthropic/claude-sonnet-4.6
AI_GATEWAY_RESEARCH_MODEL=anthropic/claude-sonnet-4.6

# AWS Lambda agent
AWS_AGENT_ENDPOINT=
ALLOW_LOCAL_AGENT_FALLBACK=true
STUDENTOS_STRICT_JUDGE=false
AWS_REGION=us-west-2
AWS_DEFAULT_REGION=us-west-2

# AWS source services
USE_REAL_AWS=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_S3_BUCKET=
AWS_TEXTRACT_REGION=us-west-2

# AWS Bedrock
USE_REAL_BEDROCK=false
AWS_BEDROCK_REGION=us-west-2
AWS_BEDROCK_MODEL_ID=

# Exa
USE_REAL_EXA=false
EXA_API_KEY=
